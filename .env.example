FLASK_SECRET_KEY=change-me

# IA complementar é OPCIONAL e fica desligada na interface por padrão.
# Na VPS, mantenha AI_PROVIDER=none se não quiser usar LLM.
# Valores: none | ollama | openai_compatible
AI_PROVIDER=none

# Opção 1: Ollama no desktop/laboratório.
# A URL pode ser um IP Tailscale do computador de casa.
# Exemplo: http://100.x.y.z:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Opção 2: LM Studio ou outro servidor compatível com OpenAI.
# Também pode apontar para o IP Tailscale do desktop.
# Exemplo: http://100.x.y.z:1234/v1
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
